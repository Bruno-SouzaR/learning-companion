# Local LLM Provider Configuration on Intel Arc 140V (Vulkan iGPU)
# Default stack: Qwen 3.5 4B Q5_K_M (Synthesis & Quizzes) + GLM-OCR (Document OCR)
LLM_BASE_URL="http://127.0.0.1:8080/v1"
LLM_API_KEY=""
LLM_MODEL="qwen3.5:4b-q5"

# Optional Task-Specific Overrides (use pnpm run model:switch to swap)
# LLM_MODEL_ENGLISH="qwen3.5:2b-q5"
# LLM_MODEL_STUDIES="qwen3.5:4b-q5"

# Server Port
PORT=3000
